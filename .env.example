# Template only. Never put real secrets in this file.
# Copy to `.env.local` (gitignored) and fill in there for local use.
# For production, set these directly in Vercel: Project Settings → Environment Variables.

# CMS Admin Basic Auth — Vercel Edge Middleware
# Strong password recommended (>= 24 chars).
ADMIN_USER=
ADMIN_PASSWORD=

# GitHub OAuth credentials for Decap CMS git backend.
# Create OAuth App: https://github.com/settings/applications/new
#   Homepage URL:        https://your-domain.vercel.app
#   Authorization URL:   https://your-domain.vercel.app/api/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
