# Template only. Never put real secrets here. Use .env.local for local dev.
# In production, set these in Vercel: Project Settings → Environment Variables.

# CMS Admin Basic Auth — Vercel Edge Middleware
# Strong password recommended (>= 24 random chars).
ADMIN_USER=
ADMIN_PASSWORD=

# Server-side GitHub PAT used by /api/auth to grant Decap CMS write access.
# Create at: https://github.com/settings/personal-access-tokens/new
#   Repository access: only the content repo
#   Permissions:
#     - Contents: Read and write
#     - Metadata: Read
# Treat like a password. Rotate periodically.
GITHUB_TOKEN=
